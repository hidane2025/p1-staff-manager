# P1 Staff Manager — Basic認証つきリバースプロキシ設定（2026-07-29 改訂）
#
# ■ 設計（2026-07-29 の敵対レビューを受けて全面的に作り直した）
#   旧版は「/receipt_download と /contract_sign だけ認証免除」だったが、これは
#   2つの理由で破綻していた:
#     ① Streamlitは画面の中身も操作も全て /_stcore/stream（WebSocket）を通る。
#        そこを認証免除にすると、Basic認証は事実上「何も守っていない」状態になる。
#     ② 逆に免除しないと、スタッフ用ページが読み込むJS/CSSが401になり真っ白になる。
#   → 1プロセスに同居させる限り、この二律背反は解けない。
#
#   そこでアプリを2プロセスに分けた:
#     ・管理アプリ  (app.py)            … ポート ${ADMIN_PORT}。/ 配下すべて認証必須
#     ・スタッフ用  (staff_site/app.py) … ポート ${STAFF_PORT}。--server.baseUrlPath=staff
#                                          で起動し、WebSocketも静的資産も /staff/ 配下に入る
#   nginxは /staff/ の前置詞だけを認証免除にすればよく、管理側の /_stcore/ は
#   認証の内側に残る。スタッフ用プロセスには管理ページのファイルが存在しない。
#
# ${PORT} ${ADMIN_PORT} ${STAFF_PORT} ${API_PORT} は起動時に envsubst で実値へ置換される。
# （$host や $remote_addr など nginx 自身の変数は proxy_params.conf 側に置き、
#   envsubst の置換対象から外している。混ぜると空文字に潰されるため。）

# WebSocketのUpgradeがある時だけ Connection: upgrade を送る
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# 2026-07-29: レート制限。
#   ・Basic認証の総当たりは「セッション単位」の制限では回避できる（毎回新規接続すればよい）
#     ため、IP単位でnginx側に置く。
#   ・スタッフ用は認証免除なので、1つのIPから接続を大量に張られると
#     単一コンテナの資源を枯渇させられる。同時接続数も制限する。
limit_req_zone  $binary_remote_addr zone=p1_admin_req:10m rate=30r/m;
limit_req_zone  $binary_remote_addr zone=p1_api_req:10m   rate=120r/m;
limit_conn_zone $binary_remote_addr zone=p1_staff_conn:10m;
limit_req_status 429;
limit_conn_status 429;

# アクセスログからクエリ文字列を落とす。
# 領収書・契約書のURLは ?token=... 自体が鍵なので、素のログに残すと
# ログ閲覧権限がある人が本人になりすませてしまう。
log_format p1_noargs '$remote_addr - [$time_local] '
                     '"$request_method $uri $server_protocol" '
                     '$status $body_bytes_sent';

server {
    listen ${PORT};
    server_name _;

    access_log /dev/stdout p1_noargs;
    error_log  /dev/stderr warn;

    # アップロード上限。Streamlit側（--server.maxUploadSize）と必ず揃えること。
    # 揃っていないとUIで選べたのに送信時だけ413で落ちる。
    client_max_body_size 16m;

    # ------------------------------------------------------------
    # スタッフ向け公開サイト（Basic認証 免除）
    #   /staff/receipt_download?token=... … 領収書ダウンロード
    #   /staff/contract_sign?token=...     … 業務委託契約の締結
    #   /staff/_stcore/...                 … このアプリ専用のWebSocket・ヘルスチェック
    #   /staff/static/...                  … このアプリ専用の静的資産
    #
    #   ^~ を付けて、下の正規表現locationより優先させる。
    #   このプロセスには管理ページのファイルが存在しないので、
    #   URLを直接叩かれても管理機能には到達できない。
    # ------------------------------------------------------------
    location ^~ /staff/ {
        auth_basic off;
        # 1IPあたりの同時接続を制限（スタッフは1人1〜2接続。20あれば実運用に支障はない）
        limit_conn p1_staff_conn 20;
        proxy_pass http://127.0.0.1:${STAFF_PORT};
        include /etc/nginx/p1_proxy_params.conf;
    }

    # ------------------------------------------------------------
    # 勤怠受信API（P1会員アプリ→本システム。2026-08-13）
    #   認証はアプリ内で検証する（Basic＋X-API-Key の二重）。nginx層のBasicを
    #   かけると Authorization ヘッダが人間用の資格情報を要求してしまうため off。
    # ------------------------------------------------------------
    location ^~ /api/ {
        auth_basic off;
        limit_req zone=p1_api_req burst=40 nodelay;
        proxy_pass http://127.0.0.1:${API_PORT};
        include /etc/nginx/p1_proxy_params.conf;
    }

    # ------------------------------------------------------------
    # 管理アプリ = それ以外すべて（/_stcore/ の WebSocket を含む）
    #   ここを通らないと画面は1文字も描画されない。
    # ------------------------------------------------------------
    location / {
        auth_basic "P1 Staff Manager";
        auth_basic_user_file /etc/nginx/.htpasswd;
        # パスワード総当たりの抑制（毎分30回まで。瞬間的な連打は10回まで許容）
        limit_req zone=p1_admin_req burst=10 nodelay;
        proxy_pass http://127.0.0.1:${ADMIN_PORT};
        include /etc/nginx/p1_proxy_params.conf;
    }
}
